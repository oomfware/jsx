{
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,

	"experimentalSortImports": {
		"customGroups": [{ "groupName": "bun", "elementNamePattern": ["bun", "bun:"] }],
		"groups": [
			["type-builtin", "value-builtin"],
			"bun",
			["type-external", "value-external"],
			["type-parent", "value-parent"],
			["type-sibling", "type-index", "value-sibling", "value-index"]
		],
		"newlinesBetween": true
	},

	"overrides": [
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 100,
				"proseWrap": "always"
			}
		},
		{
			"files": ["tsconfig.json", "jsconfig.json"],
			"options": {
				"parser": "jsonc"
			}
		}
	]
}
