{
	"name": "@oomfware/jsx",
	"version": "0.1.8",
	"description": "server-side JSX renderer",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/jsx"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./jsx-dev-runtime": "./dist/jsx-dev-runtime.mjs",
		"./jsx-runtime": "./dist/jsx-runtime.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"csstype": "^3.2.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"bumpp": "^11.0.1",
		"oxfmt": "^0.43.0",
		"oxlint": "^1.58.0",
		"oxlint-tsgolint": "^0.19.0",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2"
	}
}
